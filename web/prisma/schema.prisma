// PharmaLink Global — Phase 1 (MVP) data model
// Maps to BACKLOG.md epics F0–F7. See ARCHITECTURE.md §7.
//
// Provider note: SQLite is used for zero-setup local dev + fast CI/e2e runs.
// Production target is PostgreSQL (ARCHITECTURE.md). To switch:
//   1. provider = "postgresql", url = env("DATABASE_URL")
//   2. String status/role fields below can become native enums
//   3. Float money fields should become Decimal(12, 4)
// The schema is deliberately written to be portable across both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --------------------------------------------------------------------------
// Identity & access (F0.2, F0.3)
// --------------------------------------------------------------------------

/// role: "buyer" | "seller" | "both" | "admin"
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  passwordHash  String? // null for SSO-only users
  role          String    @default("buyer")
  /// Within a trading organization: "owner" manages the team + billing, "member"
  /// trades. Null for staff (no org). The first user of an org is the owner.
  orgRole       String    @default("member")
  /// Direct contact number. SSO gives us no phone, so account setup collects it —
  /// counterparties need a human to reach on a live RFQ.
  phone         String?
  emailVerified DateTime?
  image         String?
  active        Boolean   @default(true)
  deletedAt     DateTime?

  orgId String?
  org   Organization? @relation(fields: [orgId], references: [id])

  // Granular consent capture (ARCHITECTURE.md §8.3 item 3)
  consentTermsAt     DateTime?
  consentPrivacyAt   DateTime?
  consentMarketingAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  accounts      Account[]
  sessions      Session[]
  messages      Message[]
  auditLogs     AuditLog[]
  notifications Notification[]
  dsarRequests  DsarRequest[]

  @@index([orgId])
  @@index([role])
}

/// NextAuth adapter model — links OAuth/SAML identities to a local User.
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --------------------------------------------------------------------------
// Organizations & verification (F2, F3, F6.1)
// --------------------------------------------------------------------------

/// kind: "buyer" | "seller" | "both"
/// status: "draft" | "pending" | "verified" | "rejected"
model Organization {
  id        String  @id @default(cuid())
  name      String
  kind      String  @default("buyer")
  status    String  @default("draft")
  country   String  @default("India")
  city      String?
  regNumber String? // GST / CIN / registration number
  duns      String?
  website   String?
  about     String?

  // --- Buyer-specific ---
  companyType        String? // finished-dosage | cdmo | generic | trader
  /// Sourcing preferences (F3.3) — drive RFQ routing + a personalised catalog.
  /// Comma-separated by design: small, fixed vocabularies read as a whole set,
  /// never joined or aggregated on. Anything queried per-value gets a table.
  sourcingCategories String? // "API,Excipient"
  regulatoryMarkets  String? // "US,EU,WHO"
  preferredOrigins   String? // "India,China"

  // --- Seller-specific ---
  exportMarkets String? // comma-separated: "US,EU,WHO"
  /// Declared DMF / CEP / ASMF reference numbers (F2.3).
  dmfNumbers    String?
  /// Is this org the actual manufacturer, or an intermediary?
  /// "manufacturer" | "cdmo" | "distributor" | "trader"
  ///
  /// The highest-value trust signal in API trade: a reseller presenting itself
  /// as the manufacturer is the principal counterparty fraud. A manufacturer
  /// claim is only credible alongside a declared site + a site-level GMP
  /// certificate, which is why lib/onboarding.ts requires one.
  supplierType  String?

  // --- Default commercial terms (F2.4), pre-filled onto new quotes ---
  defaultIncoterm     String?
  defaultPaymentTerms String?
  defaultLeadTime     String?

  /// Subscription plan: "free" | "growth" | "enterprise". Entitlements and
  /// limits live in lib/plans.ts. NOTE: the platform takes no cut of trade value
  /// and processes no marketplace payments — subscription is the only revenue.
  plan          String    @default("free")
  planStartedAt DateTime?
  planRenewsAt  DateTime?

  verifiedAt     DateTime?
  rejectedReason String?
  reviewedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  sites          Site[]
  certifications Certification[]
  documents      Document[]
  products       Product[]
  rfqs           Rfq[]           @relation("BuyerRfqs")
  quotes         Quote[]         @relation("SellerQuotes")
  broadcasts     RfqSupplier[]
  messages       Message[]
  invoices       Invoice[]
  apiKeys        ApiKey[]
  webhooks       Webhook[]

  reviewsReceived   Review[]           @relation("SupplierReviews")
  reviewsWritten    Review[]           @relation("AuthorReviews")
  savedSuppliers    SavedSupplier[]    @relation("SaverOrg")
  savedByOrgs       SavedSupplier[]    @relation("SavedSupplierOrg")
  buyerSamples      SampleRequest[]    @relation("BuyerSamples")
  sellerSamples     SampleRequest[]    @relation("SellerSamples")
  regulatoryActions RegulatoryAction[]

  // --- Identity & scale (supplier profile, sections A/B) --------------------
  // `duns`, `website`, `exportMarkets`, `defaultIncoterm` and
  // `defaultPaymentTerms` already exist above and are reused rather than
  // duplicated — a second column holding the same fact is a data-integrity bug
  // waiting to happen.
  /// Brand name where it differs from the registered legal name.
  tradingName  String?
  /// Resolved from the company domain — see src/lib/logo.ts. Never hotlinked
  /// from the supplier's own site.
  logoUrl      String?
  foundedYear  Int?
  employees    Int?
  /// Stock listing, e.g. "NSE: SUNPHARMA · NYSE: SUN". null = unlisted.
  listedOn     String?
  /// Registration identifiers a buyer's compliance team checks. `regNumber`
  /// above is the generic one; these are the specific registers.
  gstin        String?
  iec          String?
  feiNumber    String?
  /// Which trade association vouches for this supplier, e.g. "BDMA,Pharmexcil".
  associations String?

  // --- Curated company detail (template sheet 1) ------------------------------
  /// The template's `Company_ID` — `SELL-IND-0001`, "never changes once
  /// assigned". Globally unique, unlike Product.externalId, whose documented
  /// format ends in a per-company sequence.
  externalId String? @unique

  /// The template's `Verification_Status`: how good the CURATED RECORD is.
  ///
  /// Deliberately NOT `status`. That column is ops approval — it gates the
  /// catalogue's "only verified suppliers are ever returned" invariant and the
  /// whole REQUIRES_VERIFIED permission set in rbac.ts. A curator writing
  /// "Verified" into it would publish an imported company as an RFQ-eligible
  /// supplier with no human review at all.
  /// verified | unverified | outdated | flagged | duplicate
  curationStatus String?

  /// Two subsidiaries of one parent are not dual sourcing — a real supply-risk
  /// input, not just an org-chart detail.
  parentCompany    String?
  /// Comma-separated, per the convention above. Drives a supplier-level filter.
  therapeuticAreas String?
  revenueUsdM      Float?
  /// The year the revenue figure is for. Not optional in practice: a revenue
  /// number without its year invites a stale figure being read as current.
  revenueYear      String?
  generalEmail     String?
  hqPhone          String?
  /// Sheet 9 says a contact's LinkedIn is always shown, so the company's is
  /// part of the same public tier.
  linkedinUrl      String?
  addressLine      String?
  state            String?
  postalCode       String?

  // --- Provenance -------------------------------------------------------------
  // Every curated record carries where it came from and when it was last
  // checked. "Outdated (>6 months)" is computed from `lastVerifiedAt` rather
  // than stored, and the template makes Source URL a required, non-blank field.
  sourceUrl      String?
  dataSourceName String?
  curatedAt      DateTime?
  curatedBy      String?
  lastVerifiedAt DateTime?
  curationNote   String?

  filings  RegulatoryFiling[]
  contacts Contact[]

  @@index([status])
  @@index([kind])
  @@index([curationStatus])
}

// --------------------------------------------------------------------------
// Buyer trust — supplier ratings/reviews + saved (shortlisted) suppliers.
// --------------------------------------------------------------------------

/// Regulatory enforcement history against a supplier — warning letters, import
/// alerts, 483 observations, EU non-compliance. Sourced from openFDA and the
/// EudraGMDP register, never self-declared: an active import alert is a
/// deal-breaker and a supplier cannot be trusted to disclose their own.
model RegulatoryAction {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// warning_letter | import_alert | form_483 | eu_noncompliance | recall
  kind      String
  /// open | closed | resolved
  status    String    @default("open")
  reference String?
  site      String?
  summary   String?
  issuedAt  DateTime
  closedAt  DateTime?

  sourceName String
  sourceUrl  String?
  /// Upstream natural key so re-ingesting is idempotent.
  sourceRef  String  @unique

  ingestedAt DateTime @default(now())

  @@index([orgId, status])
  @@index([kind])
}

model Review {
  id            String       @id @default(cuid())
  supplierOrgId String
  supplierOrg   Organization @relation("SupplierReviews", fields: [supplierOrgId], references: [id], onDelete: Cascade)
  authorOrgId   String
  authorOrg     Organization @relation("AuthorReviews", fields: [authorOrgId], references: [id], onDelete: Cascade)
  authorUserId  String?

  rating Int // 1..5
  title  String?
  body   String?
  tags   String? // comma-separated: "Quality,Fast response"

  /// True when the author org has a completed deal with this supplier — a
  /// verified-purchase signal. Reviews are only allowed from verified buyers.
  verifiedBuyer Boolean @default(false)
  status        String  @default("published") // published | hidden (ops moderation)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([supplierOrgId, authorOrgId]) // one review per buyer-org per supplier
  @@index([supplierOrgId, status])
}

model SavedSupplier {
  id            String       @id @default(cuid())
  orgId         String // the buyer org that shortlisted
  org           Organization @relation("SaverOrg", fields: [orgId], references: [id], onDelete: Cascade)
  supplierOrgId String
  supplierOrg   Organization @relation("SavedSupplierOrg", fields: [supplierOrgId], references: [id], onDelete: Cascade)
  note          String?
  createdAt     DateTime     @default(now())

  @@unique([orgId, supplierOrgId])
  @@index([orgId])
}

model Site {
  id           String       @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  /// Human-readable summary ("Halol, Gujarat"). Kept for display and for rows
  /// created before the structured address below existed.
  location     String
  /// Free-text claim captured at onboarding. The authoritative, ops-verified
  /// record is the Certification rows below — never trust this for matching.
  certsClaimed String?

  // --- Structured address ------------------------------------------------
  // A GMP certificate names one specific site. Ops has to match the address on
  // the certificate against a real, checkable place, which free text does not
  // support — hence the discrete fields.
  addressLine  String?
  city         String?
  state        String?
  postalCode   String?
  country      String?
  /// "manufacturing" | "packaging" | "warehouse" | "laboratory"
  siteType     String  @default("manufacturing")
  /// Regulatory site identifier: FDA FEI, EudraGMDP reference, CDSCO site code.
  /// This is what lets a verifier look the site up in the issuing authority's
  /// own register instead of trusting the uploaded PDF.
  regulatoryId String?

  // --- Curated facility detail (template sheet 8) -----------------------------
  // Sheet 8 is "one row per manufacturing site" and its own note calls the FDA
  // FEI "the primary key". That is `regulatoryId` above, already written by the
  // onboarding wizard — so the sheet lands on Site rather than a parallel
  // `Facility` model. A second model would fork the answer to "which site does
  // this GMP certificate belong to", which is the one thing that makes a
  // certificate checkable (Certification.siteId points here).
  externalId           String?
  /// EudraGMDP site registration, distinct from the FDA FEI in `regulatoryId`.
  emaSiteRef           String?
  /// Per-authority GMP standing. Parsed from the sheet into one vocabulary.
  fdaGmpStatus         String?
  euGmpStatus          String?
  whoGmpStatus         String?
  /// Inspection history. The outcome vocabularies differ by authority and the
  /// template is emphatic about using the exact terms — NAI/VAI/OAI for the FDA,
  /// Satisfactory/Deficiency/Refused for the EMA — so they are separate columns
  /// rather than one column that would need to carry its own authority.
  lastFdaInspectionAt  DateTime?
  fdaInspectionOutcome String?
  lastEuInspectionAt   DateTime?
  euInspectionOutcome  String?
  form483Count         Int?
  /// Capacity and its unit. Sheet 8's own heading is "Annual Capacity (MT or
  /// Units)" with a separate unit column — a number without it is meaningless.
  capacityValue        Float?
  capacityUnit         String?
  utilizationPct       Float?
  manufacturingType    String?
  containmentLevel     String?
  sterile              Boolean?
  coldChainCapability  String?
  productionLines      Int?
  qcLabs               Int?
  yearEstablished      Int?
  employees            Int?

  // --- Provenance -------------------------------------------------------------
  sourceUrl      String?
  dataSourceName String?
  lastVerifiedAt DateTime?

  certifications Certification[]

  @@unique([orgId, externalId])
  @@index([orgId])
}

/// status: "pending" | "verified" | "rejected"
/// A certification belongs to an Organization, and optionally to a specific
/// manufacturing Site (a GMP cert is issued per site, not per company — F2.2).
model Certification {
  id          String       @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  siteId      String?
  site        Site?        @relation(fields: [siteId], references: [id], onDelete: SetNull)
  name        String // "US FDA GMP" | "EU GMP" | "WHO PQ" | "CDSCO" | "NMPA" | ...
  status      String       @default("pending")
  expiresAt   DateTime?
  verifiedVia String? // "FDA drug database" | "EudraGMDP" | "CDSCO portal"

  /// "certification" (GMP, ISO, WHO PQ) or "licence" (manufacturing licence,
  /// wholesale drug licence, IEC).
  ///
  /// Licences share this model rather than getting their own because they are
  /// structurally identical for our purposes — both are issued by an authority,
  /// carry a number, expire, and are evidenced by a document. Reusing it means
  /// licences get the expiry register in lib/compliance.ts for free instead of
  /// silently falling outside it.
  category         String    @default("certification")
  /// The number printed on the certificate or licence, e.g. "MFG/GJ/2019/1183".
  number           String?
  issuingAuthority String?
  issuedAt         DateTime?
  /// The certificate file this claim was verified against.
  documentId       String?   @unique
  document         Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([siteId])
  @@index([status])
  @@index([expiresAt]) // drives the cert-expiry register (F6.5)
}

/// kind: "gmp_cert" | "mfg_licence" | "company_reg" | "drug_licence" | "coa" | "spec"
/// status: "pending" | "verified" | "rejected"
model Document {
  id        String       @id @default(cuid())
  /// The org that owns (uploaded) the file — always set, drives access control.
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind      String
  filename  String
  mimeType  String?
  sizeBytes Int?

  // --- Optional attachment targets -------------------------------------
  // A document is either a company/regulatory doc (all null) or attached to
  // exactly one of these: an RFQ spec sheet, a quote's CoA, or a message file.
  rfqId     String?
  rfq       Rfq?     @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quoteId   String?
  quote     Quote?   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  certification Certification?
  /// Opaque storage key (local FS in dev, object-storage key in prod).
  /// Never a public URL — downloads are always brokered by /api/documents/[id].
  storageKey    String?
  /// SHA-256 of the bytes — document integrity (ARCHITECTURE.md §8.2, R18 precursor)
  sha256        String?
  status        String         @default("pending")
  reason        String?
  reviewedById  String?
  reviewedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([status])
  @@index([sha256]) // verify-by-hash lookup (ARCHITECTURE.md §8.2)
  @@index([rfqId])
  @@index([quoteId])
  @@index([messageId])
}

/// In-app notification centre (BACKLOG F5.1). Email/WhatsApp fan-out reads the
/// same rows via lib/email.ts so channels never drift apart.
model Notification {
  id     String    @id @default(cuid())
  userId String
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind   String // "rfq.matched" | "quote.received" | "quote.accepted" | "org.verified" | ...
  title  String
  body   String?
  link   String?
  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

// --------------------------------------------------------------------------
// Catalog (F1, F2.4)
// --------------------------------------------------------------------------

/// category: "API" | "Intermediate" | "KSM" | "Excipient"
/// status: "draft" | "live" | "unpublished"
model Product {
  id              String       @id @default(cuid())
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String
  cas             String
  category        String       @default("API")
  grade           String? // IP / BP / USP / EP
  purity          String?
  moqKg           Int          @default(1)
  leadTime        String?
  priceMin        Float?
  priceMax        Float?
  shelfLife       String?
  storage         String?
  formula         String? // molecular formula, e.g. C8H9NO2
  /// Whether the supplier can provide a paid/free sample of this product.
  sampleAvailable Boolean      @default(false)
  status          String       @default("draft")

  // --- Per-product compliance (F2.4) ---
  /// Drug Master File / Certificate of Suitability / Certificate of Pharmaceutical Product.
  dmfNumber          String?
  cepNumber          String?
  coppNumber         String?
  /// Controlled-substance schedule (e.g. "DEA II", "NDPS"). null = not controlled.
  /// Listings with a schedule set are held for manual review — the jurisdiction-aware
  /// policy engine is Phase 3 (gap G13).
  controlledSchedule String?

  // --- Taxonomy (see src/lib/taxonomy.ts) ------------------------------------
  /// api | ksm | intermediate | raw_material | excipient | fdf | specialty
  productType String  @default("api")
  /// Facet within the segment: therapeutic area for APIs, dose form for FDFs,
  /// function for excipients. One column because a product has exactly one.
  facet       String?

  // --- Identity & chemistry --------------------------------------------------
  /// Full systematic name. Distinct from `name`, which is the trade name a
  /// buyer searches by ("Metformin HCl" vs "1,1-Dimethylbiguanide HCl").
  iupacName       String?
  molecularWeight Float?
  /// WHO ATC code — the standard therapeutic classification.
  atcCode         String?
  physicalForm    String?

  // --- Technical specification -----------------------------------------------
  /// Numeric purity so it can be range-filtered. `purity` above stays as the
  /// human string ("≥ 99.0%, HPLC") because the spec sheet wording matters.
  purityPct      Float?
  particleSize   String?
  chirality      String?
  polymorphForm  String?
  synthesisRoute String?

  // --- Synthesis lineage (KSMs and intermediates) ----------------------------
  /// The API this material feeds, as a plain CAS rather than a self-relation.
  /// A KSM's parent API is a fact about chemistry, true whether or not anyone
  /// on this platform lists it — the same reasoning that keeps PriceObservation
  /// keyed on CAS with no FK. A relation would be null for every parent nobody
  /// lists, and would break on import ordering. Resolving at query time also
  /// gives the more useful answer: who ELSE supplies that API, plural.
  parentApiCas  String?
  parentApiName String?
  synthesisStep String?
  /// ICH Q11: starting material vs intermediate. Decides what must be filed.
  ichQ11Class   String?

  // --- Finished dose forms ---------------------------------------------------
  strength     String?
  routeOfAdmin String?

  // --- Raw materials & excipients --------------------------------------------
  /// Plant / animal / synthetic — required for the dietary-compliance filters.
  origin           String?
  /// Nullable Booleans on purpose: unknown is NOT the same as no. A buyer
  /// filtering for Halal-certified excipients must not be shown an uncurated
  /// product, and must not have it silently excluded either — which is exactly
  /// what a non-nullable Boolean defaulting to false would do.
  nonGmo           Boolean?
  bseTseFree       Boolean?
  halal            Boolean?
  kosher           Boolean?
  vendorQualStatus String?

  // --- Intellectual property -------------------------------------------------
  ipStatus     String?
  patentExpiry String?

  // --- Commercial ------------------------------------------------------------
  /// Numeric lead time so the catalogue can sort and range-filter on it.
  /// `leadTime` above stays the human string ("2–3 weeks"), which is what a
  /// seller writes and a buyer reads. Without this column `SORT_MAP.lead_time`
  /// silently fell back to newest-first and the "maximum lead time" filter was
  /// parsed but never applied.
  ///
  /// A range resolves to its UPPER bound: the filter means "no longer than", so
  /// a supplier quoting 3–5 weeks must not match a buyer asking for 21 days.
  leadTimeDays     Int?
  /// Expedited lead time where the supplier offers one, same units.
  expediteLeadDays Int?
  /// Comma-separated incoterms this listing is offered on, e.g. "FOB,CIF,DDP".
  incoterms        String?
  /// ambient | refrigerated | frozen | ultracold
  coldChain        String?
  packaging        String?
  /// in_stock | made_to_order | low
  stockStatus      String  @default("made_to_order")
  /// Annual capacity in metric tonnes, for scale-up questions.
  capacityMtYr     Float?
  /// Current utilisation of that capacity, %. Headroom is a supply-risk input.
  utilizationPct   Float?
  /// European Active Substance Master File reference.
  asmfNumber       String?

  /// What `priceMin`/`priceMax` and `moqKg` are actually denominated in.
  ///
  /// Load-bearing. Sheet 3 of the curation template prices finished dose forms
  /// PER UNIT — $0.042 a tablet — while `priceMin`, the price range filter,
  /// `SORT_MAP.price_low`, `match-score.ts` and `PriceObservation.unitPriceUsdKg`
  /// are all per-kilogram. Without a unit, one tablet price wins every
  /// "price, low to high" sort forever and drags the market median for any CAS
  /// it shares with an API listing. The price sort and range filter are
  /// restricted to `priceUnit = "kg"` for exactly this reason.
  priceUnit String @default("kg")
  moqUnit   String @default("kg")

  /// Customs classification. Real per-product HS codes let the customs price
  /// connector stop depending on the hand-maintained HS_BY_CAS map in
  /// `market-data.ts`.
  hsCode  String?
  hsnCode String?

  /// The template's `Product_ID`, e.g. `API-1115704-0001`.
  ///
  /// Scoped unique, NOT global. The documented format
  /// `[CAT]-[CAS_stripped]-[COMPANY_SEQ]` ends in a per-company sequence, so
  /// the next supplier of metformin produces the same string. A global unique
  /// would throw on the second one.
  externalId String?

  // --- Provenance -------------------------------------------------------------
  sourceUrl      String?
  dataSourceName String?
  lastVerifiedAt DateTime?

  /// The long tail of the curation template's ~250 product columns, as JSON
  /// held in text — the `Deal.termsJson` precedent, since this schema has no
  /// `Json` columns and Postgres portability is a stated goal.
  ///
  /// Opaque to the database, NOT to the application: its keys are governed by
  /// the registry in `src/lib/product-spec.ts`, which is also what renders,
  /// edits and exports them. Nothing here is ever queried — a field that needs
  /// a filter gets promoted to a real column, and that promotion is the
  /// deliberate act, with a backfill.
  specJson String?

  certifications ProductCertification[]
  priceTiers     ProductPriceTier[]
  sampleRequests SampleRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, externalId])
  @@index([orgId])
  @@index([cas])
  @@index([status])
  @@index([controlledSchedule])
  /// Answers "who supplies the API this KSM feeds" without a self-relation.
  @@index([parentApiCas])
}

/// A buyer's request for a product sample; the seller approves/ships/declines.
model SampleRequest {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyerOrgId    String
  buyerOrg      Organization @relation("BuyerSamples", fields: [buyerOrgId], references: [id], onDelete: Cascade)
  sellerOrgId   String
  sellerOrg     Organization @relation("SellerSamples", fields: [sellerOrgId], references: [id], onDelete: Cascade)
  requestUserId String?

  /// requested → approved → shipped | declined
  status        String  @default("requested")
  quantityG     Int? // grams requested
  shipTo        String?
  note          String?
  declineReason String?
  trackingRef   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, buyerOrgId]) // one open request per buyer per product
  @@index([sellerOrgId, status])
  @@index([buyerOrgId])
}

/// Volume price break for a product — cheaper per-kg above a quantity threshold.
model ProductPriceTier {
  id         String  @id @default(cuid())
  productId  String
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQtyKg   Int
  pricePerKg Float

  @@index([productId])
}

/// Certifications claimed for a specific product (distinct from the org/site-level
/// certifications that gate RFQ matching).
model ProductCertification {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String

  @@unique([productId, name])
  @@index([productId])
}

// --------------------------------------------------------------------------
// RFQ → Quote → Deal (F4)
// --------------------------------------------------------------------------

/// status: "draft" | "open" | "quoted" | "accepted" | "expired" | "closed"
model Rfq {
  id              String       @id @default(cuid())
  reference       String       @unique // RFQ-2041
  buyerOrgId      String
  buyerOrg        Organization @relation("BuyerRfqs", fields: [buyerOrgId], references: [id], onDelete: Cascade)
  productName     String
  cas             String
  quantityKg      Int
  requiredBy      DateTime
  grade           String?
  minPurity       String?
  /// comma-separated mandatory certs, e.g. "US FDA GMP,WHO PQ"
  requiredCerts   String?
  incoterm        String?
  destination     String?
  targetPrice     Float?
  sampleRequested Boolean      @default(false)
  notes           String?
  status          String       @default("draft")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quotes      Quote[]
  broadcasts  RfqSupplier[]
  messages    Message[]
  deal        Deal?
  attachments Document[] // buyer's specification sheet(s)

  @@index([buyerOrgId])
  @@index([status])
}

/// The rule-based broadcast list (F4.2). A supplier can decline (no-bid) so the
/// buyer and the ops RFQ-monitor can tell "won't quote" from "hasn't looked".
model RfqSupplier {
  rfqId String
  orgId String
  rfq   Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  notifiedAt    DateTime  @default(now())
  declinedAt    DateTime?
  declineReason String?

  @@id([rfqId, orgId])
  @@index([orgId])
}

/// status: "submitted" | "accepted" | "rejected" | "expired"
model Quote {
  id           String       @id @default(cuid())
  rfqId        String
  rfq          Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  sellerOrgId  String
  sellerOrg    Organization @relation("SellerQuotes", fields: [sellerOrgId], references: [id], onDelete: Cascade)
  unitPrice    Float
  currency     String       @default("USD")
  moqKg        Int
  leadTime     String
  incoterm     String
  paymentTerms String
  validUntil   DateTime
  notes        String?
  status       String       @default("submitted")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deal        Deal?
  attachments Document[] // CoA sample, spec sheet (F4.3)
  counters    CounterOffer[]

  @@unique([rfqId, sellerOrgId])
  @@index([sellerOrgId])
  @@index([status])
}

/// Quote acceptance produces an immutable deal record + PDF trail (F4.6)
model Deal {
  id        String @id @default(cuid())
  reference String @unique // DEAL-1188
  rfqId     String @unique
  rfq       Rfq    @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  quoteId   String @unique
  quote     Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// Frozen snapshot of agreed terms at acceptance — never mutated afterwards.
  totalValue Float
  currency   String @default("USD")
  termsJson  String

  shipment Shipment?

  createdAt DateTime @default(now())
}

// --------------------------------------------------------------------------
// Post-deal fulfilment — order/shipment tracking (NO payments/escrow).
// --------------------------------------------------------------------------

model Shipment {
  id     String @id @default(cuid())
  dealId String @unique
  deal   Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// pending → shipped → in_transit → delivered → confirmed (buyer confirms receipt)
  status      String    @default("pending")
  carrier     String?
  trackingRef String?
  eta         DateTime?
  shippedAt   DateTime?
  deliveredAt DateTime?
  confirmedAt DateTime? // buyer-confirmed receipt
  note        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------------------------------------------------------------
// Structured negotiation — counter-offers on a quote (bilateral).
// --------------------------------------------------------------------------

model CounterOffer {
  id      String @id @default(cuid())
  quoteId String
  quote   Quote  @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  /// The org that proposed this counter (buyer or seller). The other party responds.
  byOrgId       String
  proposedPrice Float
  proposedQtyKg Int?
  note          String?
  status        String  @default("open") // open | accepted | declined | superseded

  createdAt DateTime @default(now())

  @@index([quoteId])
}

// --------------------------------------------------------------------------
// Messaging (F5)
// --------------------------------------------------------------------------

model Message {
  id     String       @id @default(cuid())
  rfqId  String
  rfq    Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  orgId  String
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  body   String

  attachments Document[]

  createdAt DateTime @default(now())

  @@index([rfqId])
}

// --------------------------------------------------------------------------
// Subscription billing
//
// The platform charges a SUBSCRIPTION only. It never holds, escrows or routes
// buyer↔seller trade value, and takes no GMV commission — so it stays out of
// PCI/KYC-AML scope. Invoices are issued here and settled OFF-PLATFORM (bank
// transfer / external payment link); no card data is ever stored.
// --------------------------------------------------------------------------

/// status: "issued" | "paid" | "void"
model Invoice {
  id          String       @id @default(cuid())
  number      String       @unique // INV-2026-0001
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  plan        String
  periodStart DateTime
  periodEnd   DateTime
  amount      Float
  currency    String       @default("USD")
  taxRate     Float        @default(0) // e.g. 18 for GST
  status      String       @default("issued")
  issuedAt    DateTime     @default(now())
  paidAt      DateTime?

  @@index([orgId])
  @@index([status])
}

// --------------------------------------------------------------------------
// Open API & webhooks — the integration surface other platforms plug into.
//
// A partner (e.g. a supply-chain / ERP / procurement tool) is issued an API key
// scoped to an organization, calls the read API under /api/v1, and/or registers
// webhooks to receive domain events (rfq.posted, quote.received, org.verified…)
// in near-real-time. This is the outward-facing half of the event catalogue in
// ARCHITECTURE.md §5.
// --------------------------------------------------------------------------

/// An API credential. The raw key is shown ONCE at creation; only its SHA-256
/// hash is stored, so a database leak never yields a working key.
model ApiKey {
  id        String        @id @default(cuid())
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  /// Short non-secret prefix shown in the UI so a key is identifiable ("pk_live_A1B2…").
  prefix    String
  /// SHA-256 of the full key. Never the key itself.
  hashedKey String        @unique
  /// Space-separated scopes, e.g. "catalog:read rfq:read".
  scopes    String        @default("catalog:read")
  active    Boolean       @default(true)

  createdById String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?

  @@index([orgId])
  @@index([prefix])
}

/// A subscriber endpoint. On each matching event we POST the payload with an
/// HMAC-SHA256 signature so the receiver can verify it came from us.
model Webhook {
  id     String        @id @default(cuid())
  orgId  String?
  org    Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  url    String
  /// Signing secret (HMAC). Shown once, then only used server-side.
  secret String
  /// Comma-separated event names, or "*" for all.
  events String        @default("*")
  active Boolean       @default(true)

  createdAt   DateTime  @default(now())
  lastEventAt DateTime?
  failCount   Int       @default(0)

  deliveries WebhookDelivery[]

  @@index([orgId])
}

/// One delivery attempt — an audit trail for partners debugging their endpoint.
model WebhookDelivery {
  id         String  @id @default(cuid())
  webhookId  String
  webhook    Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event      String
  status     String  @default("pending") // "delivered" | "failed"
  statusCode Int?
  error      String?

  createdAt DateTime @default(now())

  @@index([webhookId])
}

// --------------------------------------------------------------------------
// Editorial news / announcements for the public homepage.
//
// Deliberately AUTHORED by ops, not scraped or invented: publishing unverified
// regulatory claims about named manufacturers would be defamatory and would
// destroy the trust the whole marketplace rests on. Automated ingestion of FDA
// warning letters / EudraGMDP status / recalls is R17 (Phase 3) and requires a
// licensed source.
// --------------------------------------------------------------------------

/// category: "platform" | "regulatory" | "market"
/// status: "draft" | "published"
model NewsPost {
  id        String  @id @default(cuid())
  /// Posts are written per-locale rather than machine-translated — regulatory
  /// wording must not be paraphrased by a translation engine.
  locale    String  @default("en")
  title     String
  summary   String
  body      String?
  category  String  @default("platform")
  /// Link to the primary source (e.g. the FDA notice itself) so a reader can
  /// verify the claim rather than trust our summary.
  sourceUrl String?
  status    String  @default("draft")

  publishedAt DateTime?
  authorId    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, publishedAt])
  @@index([locale])
}

// --------------------------------------------------------------------------
// Data-subject rights — GDPR Art. 15 (access/portability) & Art. 17 (erasure),
// India DPDP. Requests are recorded so the statutory clock is auditable.
// ARCHITECTURE.md §8.1 / §8.3 item 11.
// --------------------------------------------------------------------------

/// kind: "export" | "erasure"
/// status: "requested" | "in_progress" | "completed" | "rejected"
model DsarRequest {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String
  status      String  @default("requested")
  /// Storage key of the generated export bundle (export requests only).
  downloadKey String?
  /// Set when erasure completes — the record itself is retained (pseudonymised)
  /// to evidence that the request was honoured.
  handledById String?
  note        String?

  requestedAt DateTime  @default(now())
  /// Statutory deadline; ops dashboards alert as this approaches.
  dueAt       DateTime?
  completedAt DateTime?

  @@index([userId])
  @@index([status])
  @@index([dueAt])
}

// --------------------------------------------------------------------------
// CMS content — ops-curated homepage content. Either authored in the CMS
// (kind="article") or a crawled external link (kind="link").
// --------------------------------------------------------------------------

model ContentItem {
  id     String @id @default(cuid())
  kind   String @default("article") // "article" | "link"
  locale String @default("en")

  title      String
  summary    String?
  body       String? // article prose (sanitized on save)
  imageUrl   String? // OG image (link) or supplied image (article)
  sourceUrl  String? // external target for kind="link" (or citation)
  sourceName String? // publisher / site name

  /// Canonical URL of a crawled link — unique so the same source can't be
  /// added twice. Null for authored articles (SQLite/Postgres allow many nulls).
  canonicalUrl String? @unique

  category String  @default("news") // news | insight | resource | announcement | event
  tags     String? // comma-separated
  status   String  @default("draft") // draft | published | archived

  /// Homepage curation: featured items surface in the "Spotlight" section,
  /// ordered by sortOrder (ascending).
  featured  Boolean @default(false)
  sortOrder Int     @default(0)

  publishedAt DateTime?
  fetchedAt   DateTime? // when the link was last crawled
  authorId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, featured, sortOrder])
  @@index([locale, status, publishedAt])
}

// --------------------------------------------------------------------------
// Audit (F0.7 / SOX-style trail, ARCHITECTURE.md §8.3 item 6)
// --------------------------------------------------------------------------

model AuditLog {
  id       String  @id @default(cuid())
  actorId  String?
  actor    User?   @relation(fields: [actorId], references: [id])
  action   String // "seller.verified" | "quote.accepted" | ...
  entity   String
  entityId String
  reason   String?
  meta     String? // JSON

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// --------------------------------------------------------------------------
// Market data & price prediction
//
// Design note: these models are deliberately keyed on the CAS number as a plain
// string rather than by FK to Product. A market price for Paracetamol exists
// whether or not anyone on this platform lists it, and most rows come from
// public sources (customs unit values, tender awards) that know a molecule but
// know nothing about our catalog.
// --------------------------------------------------------------------------

/// One observed price point for a molecule, normalised to USD per kilogram.
/// Rows come from platform activity (quotes/deals) AND external public sources.
model PriceObservation {
  id          String   @id @default(cuid())
  cas         String
  productName String
  observedAt  DateTime

  /// Normalised price — ALWAYS USD per kilogram, whatever the source quoted.
  /// All maths uses this field and only this field.
  unitPriceUsdKg Float
  /// What the source actually published, kept for audit. Never used in maths.
  rawPrice       Float
  rawCurrency    String @default("USD")
  rawUnit        String @default("kg")

  /// Kilograms behind this observation — drives volume weighting. null = unknown.
  quantityKg Float?
  incoterm   String?
  /// ISO-3166 alpha-2 of the observed market, or "WLD" for world aggregates.
  region     String  @default("WLD")

  /// internal_quote | internal_deal | customs | tender | listing
  sourceType String
  sourceName String
  sourceUrl  String?
  /// Upstream natural key — unique, so re-ingesting a source is idempotent.
  sourceRef  String  @unique

  /// 0..1 evidence weight. A signed deal is stronger evidence than a customs
  /// aggregate covering a whole HS line; the model must not pretend otherwise.
  weight Float @default(1)

  // --- Curated provenance (template sheet 6) ----------------------------------
  /// The rate applied to reach `unitPriceUsdKg`. An FX-converted price you
  /// cannot re-derive is unauditable.
  fxRate         Float?
  /// HIGH | MEDIUM | LOW -- the LABEL. `weight` above stays the number the model
  /// reads, derived from this through one exported table in `vocab.ts`, so a
  /// spreadsheet can never outvote a platform transaction by setting it directly.
  dataConfidence String?
  /// Where the goods ship FROM. `region` already means the destination market --
  /// a FOB India price and a FOB China price are different series.
  originCountry  String?
  /// 99.5% USP and 98% technical grade are not the same product, and conflating
  /// them is a major source of apparent volatility.
  purityGrade    String?
  validUntil     DateTime?
  /// Excluded from the forecast when set. A curator flagging an outlier is
  /// evidence; silently dropping it would not be.
  outlierFlag    Boolean   @default(false)
  outlierReason  String?
  /// Nullable on purpose: a market price for paracetamol exists whether or not
  /// anyone here lists it, so the CAS-keyed doctrine above still holds.
  supplierOrgId  String?

  ingestedAt DateTime @default(now())

  @@index([cas, observedAt])
  @@index([sourceType])
}

/// A macro driver series (FX, freight, input-cost index). NOT a price of the
/// molecule — a candidate explanatory variable to correlate against one.
model MarketSignal {
  id          String   @id @default(cuid())
  key         String // "fx.usdinr" | "trade.volume.294190" | ...
  label       String
  periodStart DateTime
  value       Float
  unit        String   @default("")
  sourceName  String
  sourceUrl   String?
  ingestedAt  DateTime @default(now())

  @@unique([key, periodStart])
  @@index([key])
}

/// A supply-side disruption. Shortages, recalls and regulatory actions lead
/// price moves, so they are captured as facts rather than left inside news text.
model SupplyEvent {
  id String @id @default(cuid())

  cas        String?
  /// Molecule/product name exactly as published upstream (CAS is often absent).
  subject    String
  company    String?
  /// shortage | discontinuation | recall | import_alert | warning_letter
  eventType  String
  /// low | medium | high
  severity   String   @default("medium")
  occurredAt DateTime
  detail     String?

  sourceName String
  sourceUrl  String?
  sourceRef  String  @unique

  ingestedAt DateTime @default(now())

  @@index([cas, occurredAt])
  @@index([eventType])
}

/// A firm approved to supply a molecule, as published by a public regulator.
///
/// Deliberately NOT `RegulatoryFiling`. That model is `orgId`-scoped: it records
/// a filing held by an organisation that exists on this platform. A public
/// register lists hundreds of firms that have never heard of PharmaLink, and
/// writing them there would mean fabricating an Organization row for each — the
/// directory would then be unable to tell a real member from an artefact of an
/// ingest. This is market data, keyed by CAS, exactly like PriceObservation and
/// SupplyEvent.
///
/// `basis` is the load-bearing field. `finished_dose` means the holder is
/// approved to market the finished product, which is NOT the same claim as
/// making the active ingredient — the ANDA holder for ibuprofen tablets usually
/// buys the ibuprofen. Only the FDA Type II DMF list answers the API question,
/// and it is a manual import (see DATA-SOURCES.md), so nothing here may be
/// promoted to `api_manufacturer` by inference.
model MarketSupplier {
  id  String @id @default(cuid())
  cas String

  /// Display spelling, as first published upstream.
  holderName String
  /// Legal-form-stripped key used to group spellings of one firm. Grouping only;
  /// never shown, because it is not what a buyer recognises.
  holderKey  String

  /// finished_dose | api_manufacturer
  basis String @default("finished_dose")
  /// Approved, non-discontinued applications this holder holds for the molecule.
  /// The share input to HHI — a count of approvals, never a volume.
  approvals Int @default(1)

  /// The name actually queried upstream. Differs from the INN often enough to be
  /// worth storing: openFDA has no `paracetamol`, only `acetaminophen`.
  queriedAs String?
  /// ISO-3166 alpha-2 of the regulator's jurisdiction.
  region    String @default("US")

  sourceName String
  sourceUrl  String?
  /// Upstream natural key — unique, so re-ingesting a register is idempotent.
  sourceRef  String  @unique

  ingestedAt DateTime @default(now())

  @@index([cas, basis])
  @@index([holderKey])
}

/// A forecast exactly as it was issued, kept immutably so the platform can show
/// how its past predictions actually turned out. A forecast with no scoreboard
/// is marketing, not analytics.
model PriceForecast {
  id           String   @id @default(cuid())
  cas          String
  /// First day of the month being predicted.
  horizonMonth DateTime
  issuedAt     DateTime @default(now())

  /// naive | drift | holt — whichever won the rolling-origin backtest.
  model String
  p10   Float
  p50   Float
  p90   Float

  /// Backtest error of the chosen model, in percent (MAPE).
  mape         Float?
  observations Int
  /// insufficient | low | medium | high
  confidence   String

  @@unique([cas, horizonMonth, issuedAt])
  @@index([cas])
}

/// One execution of one external connector. Ingestion that fails silently is
/// worse than no ingestion, so every run is recorded whether it worked or not.
model IngestRun {
  id         String    @id @default(cuid())
  source     String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  /// running | ok | failed
  status     String    @default("running")
  fetched    Int       @default(0)
  inserted   Int       @default(0)
  skipped    Int       @default(0)
  error      String?

  @@index([source, startedAt])
}

// --------------------------------------------------------------------------
// Curated supplier intelligence (Data Curation Template v3, sheets 7 and 9)
// --------------------------------------------------------------------------

/// A regulatory submission a buyer's regulatory team can reference.
///
/// Distinct from the two models it sits between, and the boundary is worth
/// stating because all three are "regulatory":
///
///   - `Certification` is a credential the supplier HOLDS: issued to them,
///     numbered, expiring, evidenced by a Document, and driving the expiry
///     register in lib/compliance.ts. It answers "may this site legally
///     manufacture".
///   - `RegulatoryFiling` is a submission SOMEONE ELSE REFERENCES: a DMF, ASMF,
///     CEP, ANDA, NDA or MAA. It has a lifecycle rather than an expiry — many
///     have no expiry at all ("N/A — DMF, no expiry") — a type, a scope, an
///     open-to-reference flag and a count of filings that cite it. It answers
///     "can my regulatory team cite this supplier in my submission", which is a
///     different question checked against a different register.
///   - `RegulatoryAction` is an ADVERSE finding, sourced from openFDA and
///     EudraGMDP and never self-declared. Nothing here writes it.
///
/// One deliberate bridge: `expiresAt` feeds the same expiry register as
/// certificates, because compliance.ts's `summarize()` and `certExpiryLevel()`
/// are pure and already take `{ expiresAt }[]`. A CEP is genuinely both a
/// certificate and a filing; it lives here only.
model RegulatoryFiling {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  /// The template's `Filing_ID`, e.g. `RF-2026-0001`.
  externalId String?

  /// Optional: a DMF is per-product, a company GMP filing is not.
  productId   String?
  cas         String?
  productName String?

  /// US FDA Type II DMF | ASMF | CEP | ANDA | NDA | EU MAA | WHO PQ | CDSCO | PMDA
  filingType   String
  filingNumber String
  authority    String?
  country      String?
  /// active | approved | pending | suspended | withdrawn | expired
  status       String  @default("active")

  filedAt      DateTime?
  approvedAt   DateTime?
  /// Null is a real, common answer — a DMF does not expire. `certExpiryLevel`
  /// buckets that as "unknown", never as "ok".
  expiresAt    DateTime?
  renewalDueAt DateTime?

  holderName       String?
  scope            String?
  /// Whether third parties may cite this filing — the whole point of a DMF.
  openToReference  Boolean?
  /// How many ANDAs/MAAs already reference it. A commercial trust signal.
  referencingCount Int?
  annualFeeUsd     Float?

  lastInspectionAt      DateTime?
  lastInspectionOutcome String?
  form483Count          Int?
  capaStatus            String?

  /// Comma-separated site references (FEI or site name), resolved at render.
  ///
  /// KNOWN DEBT. This is multi-valued AND genuinely queryable ("which filings
  /// cover this site"), so by the convention at the top of this file it deserves
  /// a join table. Deferred until a per-site filing filter is actually asked
  /// for, rather than built on speculation — but it is debt, not a design.
  sitesCovered String?

  // --- Provenance -------------------------------------------------------------
  sourceUrl      String?
  dataSourceName String?
  lastVerifiedAt DateTime?
  verifiedBy     String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, filingType, filingNumber])
  @@index([orgId, status])
  @@index([expiresAt])
  @@index([cas])
}

/// A named person at a supplier, for buyer outreach.
///
/// ## What is deliberately absent
///
/// Sheet 9 also carries `Personal Email`, `Twitter / X Handle`,
/// `Last Contacted`, `Interaction Summary`, `Relationship Status` and
/// `Key Interests / Pain Points`. Those are CRM notes about a named natural
/// person, scraped from LinkedIn, with no lawful basis recorded. This platform
/// carries a DsarRequest model and explicit GDPR Art. 15/17 and DPDP
/// commitments, so importing them would make them subject-access-exportable and
/// erasure-obligated for data we cannot justify holding. The sheet's own header
/// says "Business email only (not personal)". The importer refuses those columns
/// at the mapper with a visible notice, rather than storing them and hiding
/// them — hidden is not the same as not held.
///
/// Visibility is decided in the query, not the component: see
/// src/lib/contact-queries.ts.
model Contact {
  id    String       @id @default(cuid())
  orgId String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  externalId String?

  salutation  String?
  firstName   String
  lastName    String
  jobTitle    String?
  department  String?
  /// c_level | vp | director | manager | executive
  seniority   String?
  /// export_sales | business_development | regulatory | quality | finance | leadership
  primaryRole String?

  /// The only email held. See the note above.
  businessEmail String?
  officePhone   String?
  mobile        String?
  /// Always visible, at every tier — the sheet is explicit about that.
  linkedinUrl   String?

  city            String?
  country         String?
  /// Comma-separated markets this person covers.
  territories     String?
  languages       String?
  /// Median response time in hours, as an outreach expectation.
  responseHours   Float?
  bestContactTime String?

  // --- Provenance -------------------------------------------------------------
  sourceUrl      String?
  dataSourceName String?
  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([orgId, businessEmail])
  @@index([orgId])
}

/// One uploaded curation workbook, and what happened to it.
///
/// The association importer re-fetches its source on apply; a file cannot be
/// re-fetched, so the preview has to be able to find the bytes again. Holding
/// them in memory breaks the moment `output: 'standalone'` runs more than one
/// instance and apply lands on a different one.
///
/// It also gives the import history that "Data Import" as a nav item implies,
/// and `sha256` gives "you already uploaded this exact file" for free.
model ImportBatch {
  id         String  @id @default(cuid())
  kind       String  @default("supplier-catalogue")
  filename   String
  /// Content hash — the same dedupe key the document upload path uses.
  sha256     String
  /// Opaque storage key, never a public URL. Downloads are brokered.
  storageKey String?
  sizeBytes  Int

  uploadedById String?
  /// uploaded | previewed | applied | failed
  status       String  @default("uploaded")

  /// Per-sheet counts as JSON text, following the Deal.termsJson precedent.
  sheetCountsJson String?
  errorCount      Int     @default(0)
  /// The row-level report, CAPPED. A 46-company import easily produces 50 KB,
  /// and AuditLog.meta has no size discipline — this is where the detail goes
  /// so the audit row stays a summary.
  reportJson      String?

  /// The IngestRun this batch was applied under, so a failed apply is visible
  /// in the same operator console as every other connector.
  ingestRunId String?

  createdAt   DateTime  @default(now())
  previewedAt DateTime?
  appliedAt   DateTime?

  @@index([kind, createdAt])
  @@index([sha256])
}

# PharmaLink — Oracle Cloud deployment settings.
#
# On the VM:  cp .env.oci.example .env  &&  nano .env
# Compose auto-loads `.env` from this directory. Never commit the real one.

# ---------------------------------------------------------------------------
# 1. Public address — the three values below must agree with each other.
# ---------------------------------------------------------------------------
# What Caddy serves on. Use ':80' for a quick no-TLS smoke test, or a hostname
# that already resolves to this VM's public IP for automatic HTTPS.
SITE_ADDRESS=pharmalink.duckdns.org

# The public origin, with scheme. Auth.js builds OAuth callback URLs from this,
# and it is baked into the client bundle at BUILD time — change it and you must
# rebuild (`up -d --build`), not just restart.
#   TLS:      https://pharmalink.duckdns.org
#   No TLS:   http://<your-vm-public-ip>
AUTH_URL=https://pharmalink.duckdns.org
NEXT_PUBLIC_SITE_URL=https://pharmalink.duckdns.org

# ---------------------------------------------------------------------------
# 2. Secrets
# ---------------------------------------------------------------------------
# REQUIRED. Generate a fresh one on the VM — do not reuse the local dev value:
#   openssl rand -base64 32
AUTH_SECRET=

# ---------------------------------------------------------------------------
# 3. Build options
# ---------------------------------------------------------------------------
# true  = bake the demo catalogue/users into the image (what you want for a demo)
# false = ship an empty database, schema only
SEED=true

# ---------------------------------------------------------------------------
# 4. Optional SSO — leave blank to hide those buttons on the sign-in page.
# ---------------------------------------------------------------------------
# Google requires an HTTPS redirect URI for any non-localhost origin, so this
# only works once SITE_ADDRESS is a real hostname with a certificate. Add
#   https://<your-host>/api/auth/callback/google
# to the OAuth client's authorised redirect URIs first.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

BOXYHQ_SAML_ISSUER=
BOXYHQ_SAML_CLIENT_ID=
BOXYHQ_SAML_CLIENT_SECRET=

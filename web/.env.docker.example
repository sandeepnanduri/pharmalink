# Copy to `.env` (compose auto-loads it) or export before `docker compose up`.
# These defaults run the demo locally; CHANGE the secret before any deployment.

# Public origin — baked into the client bundle at build AND used for canonical/OG URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Host port to expose the app on.
APP_PORT=3000

# Bake demo data into the image on build (true) or ship an empty database (false).
SEED=true

# Auth.js v5 signing secret — REQUIRED. Generate a real one:
#   openssl rand -base64 32
AUTH_SECRET=dev-only-insecure-secret-change-me-please-32b

# --- Optional company logos (leave blank to disable) ---
# Publishable key from logo.dev. Public by design — it identifies the account for
# rate limiting, it authorises nothing. Blank is a supported state: every company
# renders its deterministic monogram instead, which is the answer anyway for the
# long tail of manufacturers that have no logo asset online.
NEXT_PUBLIC_LOGO_DEV_TOKEN=

# --- Optional SSO (leave blank to disable) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
BOXYHQ_SAML_ISSUER=
BOXYHQ_SAML_CLIENT_ID=
BOXYHQ_SAML_CLIENT_SECRET=

# Note: DATABASE_URL and UPLOAD_DIR are fixed inside the image to /data/* and
# made durable by the mounted volume — you don't set them here.
